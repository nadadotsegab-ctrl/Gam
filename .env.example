# Optional for sample tools; required for actual daily player props and current odds.
# Confirm your The Odds API plan includes the requested NBA/NFL/soccer player-prop markets.
# Set this only on the server; never use a VITE_ prefix for a credential.
ODDS_API_KEY=

# Recommended for a free odds plan: scans one future event and one prop market per request.
# Only turn off after verifying your API allowance.
ODDS_API_FREE_MODE=1
